---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import '../styles/contact.css';
import '../styles/dusk.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
interface Props { title?: string; description?: string; lang?: string; footer?: boolean; bare?: boolean }
const { title, description = 'Streetlight is a creative design studio run by Matan Ben David — brand, web & product.', lang = 'en', footer = true, bare = false } = Astro.props;
const full = title ? `${title} — Streetlight` : 'Streetlight — Digital assets you’ll be proud to own';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{full}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/SimplerProMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)}>
  <meta property="og:image" content={new URL('/og.png', Astro.site)}>
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={new URL('/og.png', Astro.site)}>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <meta name="theme-color" content="#f3f2ee">
  <!-- day / dusk before the first paint, so there's no flash -->
  <script is:inline>try { if (sessionStorage.getItem('sl-theme') === 'dusk') document.documentElement.dataset.theme = 'dusk'; } catch(e){}
  if (location.pathname === '/' && /^#project\//.test(location.hash)) document.documentElement.classList.add('deep');   // a case study opened from a link: don't flash the home page first</script>
  <slot name="head" />
</head>
<body>
  <div id="sky" aria-hidden="true"></div>
  <Header><slot name="brand" slot="brand" /></Header>
  <Contact />
  {bare ? <slot /> : <main><slot /></main>}
  {footer && <Footer />}
  <script>import '../scripts/site.js'; import '../scripts/contact.js';</script>
  <slot name="end" />
  <Analytics />
  <SpeedInsights />
</body>
</html>
