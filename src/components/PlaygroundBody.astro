---
---
<div id="world"></div>

<div class="pg-head"><nav class="chips" id="filters" aria-label="Filter by tag"></nav></div>
<div id="detail"></div>

<details id="ctl" open>
  <summary>grid</summary>
  <div class="body">
    <label>tile size <i class="q" data-tip="גודל כל ריבוע בפיקסלים.">?</i><span></span><input id="size" type="range" min="50" max="260" value="260"></label>
    <label>street width <i class="q" data-tip="הרווח בין הריבועים — רוחב ה״רחובות״.">?</i><span></span><input id="gap" type="range" min="0" max="200" value="123"></label>
    <label>thickness <i class="q" data-tip="עובי הבסיס של כל ריבוע. 0 = שטוח לגמרי.">?</i><span></span><input id="thick" type="range" min="0" max="80" value="4"></label>
    <h4>height randomization</h4>
    <label class="chk"><input id="randH" type="checkbox"> random height <i class="q" data-tip="מוסיף לכל ריבוע גובה אקראי מעל העובי הבסיסי — נראה כמו עיר.">?</i></label>
    <label>max extra height <i class="q" data-tip="הגובה המקסימלי שריבוע יכול לקבל מעבר לעובי.">?</i><span></span><input id="hVar" type="range" min="0" max="400" value="90"></label>
    <label>raised tiles (%) <i class="q" data-tip="כמה מהריבועים מקבלים גובה. 100 = כולם, 20 = רק חמישית, השאר נשארים נמוכים.">?</i><span></span><input id="hShare" type="range" min="0" max="100" value="100"></label>
    <label>tower bias <i class="q" data-tip="צורת ההתפלגות. 1 = גבהים אחידים. ערך גבוה = רובם נמוכים ומעט מגדלים גבוהים.">?</i><span></span><input id="hCurve" type="range" min=".3" max="5" step=".1" value="1"></label>
    <label>hover scale <i class="q" data-tip="בכמה ריבוע גדל כשהוא מסתובב אליך בהובר.">?</i><span></span><input id="hover" type="range" min="1" max="2.5" step=".05" value="1.55"></label>
    <h4>street lamps</h4>
    <label class="chk"><input id="lamps" type="checkbox" checked> show lamps <i class="q" data-tip="הצגה/הסתרה של פנסי הרחוב.">?</i></label>
    <label>lamp style <i class="q" data-tip="סגנון הפנסים. mix מערבב אקראית בין כל הסגנונות, modern / ornate מערבב רק בתוך הקבוצה. כל הסגנונות זה לצד זה: lamp-styles.html">?</i><span></span>
      <select id="lampStyle">
        <option value="mix">mix — all</option><option value="mix-modern">mix — modern</option><option value="mix-ornate">mix — ornate</option>
        <option value="classic">classic lantern</option><option value="mushroom">mushroom</option><option value="cobra">cobra head</option>
        <option value="double">double arm</option><option value="post">post lantern</option><option value="globe">globe</option>
      </select></label>
    <div class="row radios"><label class="chk"><input type="radio" name="lampMode" value="grid"> intersections</label><label class="chk"><input type="radio" name="lampMode" value="scatter" checked> scatter</label><i class="q" data-tip="intersections = פנס בצמתים לפי מרווח קבוע. scatter = פנסים מפוזרים אקראית לאורך הרחובות.">?</i></div>
    <label>lamps per 10 frames <i class="q" data-tip="במצב scatter: כמות הפנסים ביחס לכמות התמונות שמוצגות. 1.2 = בערך פנס לכל 8 תמונות. כשמסננים ונשארות פחות תמונות — יש פחות פנסים.">?</i><span></span><input id="lampDensity" type="range" min="0" max="5" step=".1" value="1.2"></label>
    <label>min lamps <i class="q" data-tip="מינימום פנסים גם כשנשארות מעט תמונות (0 = בלי פנסים בכלל אם הרשימה קטנה מאוד).">?</i><span></span><input id="lampMin" type="range" min="0" max="6" value="1"></label>
    <label>max lamps <i class="q" data-tip="תקרה — לא יותר מזה גם כשכל התמונות מוצגות.">?</i><span></span><input id="lampMax" type="range" min="1" max="40" value="8"></label>
    <div class="lampnow">now: <b id="lampNow">—</b> lamps for <b id="frameNow">—</b> frames</div>
    <label>every N streets <i class="q" data-tip="במצב intersections: פנס בכל צומת N.">?</i><span></span><input id="every" type="range" min="1" max="8" value="2"></label>
    <label class="chk"><input id="lampRot" type="checkbox" checked> random direction <i class="q" data-tip="הזרוע של כל פנס פונה לכיוון אקראי לאורך הרחוב. כבוי = כולם לאותו כיוון.">?</i></label>
    <label>lamp size <i class="q" data-tip="גודל הפנסים ביחס לריבוע.">?</i><span></span><input id="lampSize" type="range" min=".3" max="2.5" step=".05" value="1"></label>
    <div class="row"><button data-a="shuffle">shuffle</button><i class="q" data-tip="מגריל מחדש את הגבהים ואת מיקום וכיוון הפנסים.">?</i></div>
    <h4>filter animation</h4>
    <label>fall (ms) <i class="q" data-tip="כמה זמן לוקחת הנפילה של מה שלא מתאים לפילטר.">?</i><span></span><input id="fall" type="range" min="200" max="2000" step="50" value="750"></label>
    <label>pause before regroup (ms) <i class="q" data-tip="השהייה אחרי הנפילה, לפני שהשאר מתחילים לזוז. רואים את החורים.">?</i><span></span><input id="pause" type="range" min="0" max="1500" step="50" value="250"></label>
    <label>regroup (ms) <i class="q" data-tip="משך הנסיעה של כל ריבוע למקום החדש בגוש.">?</i><span></span><input id="move" type="range" min="200" max="2500" step="50" value="1000"></label>
    <label>regroup stagger (ms) <i class="q" data-tip="הפרש הזמנים בין הריבועים — הקרובים למרכז זזים ראשונים, הרחוקים אחריהם.">?</i><span></span><input id="stagger" type="range" min="0" max="1200" step="50" value="350"></label>
    <label>arc height (px) <i class="q" data-tip="כמה הריבוע מתרומם באמצע הדרך (קשת). 0 = מחליק על הרצפה.">?</i><span></span><input id="arc" type="range" min="0" max="200" value="50"></label>
    <div id="msg" style="color:var(--mute);min-height:1.2em"></div>
    <div class="row save"><button data-a="save">save</button><button data-a="reset">reset</button><button data-a="copy">copy</button></div>
  </div>
</details>
<div id="pop"></div>

<style>
  /* site footer (same as the home page) */
  :root{--cgut:max(24px, calc((100vw - 1200px) / 2))}
  .site-foot{position:relative;z-index:50;background:var(--bg,#f3f2ee);border-top:1px solid var(--ink,#1b1b1b);padding:22px 24px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;
    font:13px/1.4 'Simpler Mono',ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--ink,#1b1b1b);margin-top:80px;clear:both}
  .site-foot a{color:var(--ink,#1b1b1b);text-decoration:none} .site-foot a:hover{color:var(--acc,#ff4d1a)}
  .site-foot .ft-l,.site-foot .ft-r{display:flex;align-items:center;gap:16px;flex-wrap:wrap} .site-foot .ft-r{justify-content:flex-end}
  .site-foot .ft-div{display:block;width:1px;height:14px;background:#cfccc4}
  .site-foot .lt-logo{display:block;height:44px;aspect-ratio:400/220;margin:-4px -2px;font-size:18px;line-height:44px}
  .site-foot .lt-logo svg{display:block;width:100%;height:100%}
  @media (max-width:800px){ .site-foot{grid-template-columns:1fr;justify-items:center} .site-foot .ft-r{justify-content:center} }
  /* inside the single-file prototype the home page's own header sits on top, so this page's header steps aside */
  /* …but the tag filters stay: they sit right under the home header, on the right */
  html.embedded body > header{top:92px !important;background:none !important;border:0 !important;justify-content:flex-start !important;padding-top:0 !important}
  html.embedded body > header .brand{display:none !important}
  /* the playground is one full-screen canvas: the footer is pinned to the bottom edge, the hint sits above it */
  .site-foot{position:fixed;left:0;right:0;bottom:0;margin:0;z-index:100001} #hint{bottom:106px !important}
  html[data-theme="dusk"] .site-foot .lt-logo svg [fill="rgb(21,19,14)"]{fill:var(--ink)} html[data-theme="dusk"] .site-foot .ft-div{background:#2c4d78}

  /* filters: square segmented chips, edge to edge — fill wipes in from the side the pointer came in (same as the budget chips) */
  #filters{gap:0 !important}
  #filters button{position:relative;overflow:hidden;isolation:isolate;border-radius:0 !important;margin:0 0 -1px 0;margin-inline-end:-1px;background:var(--bg) !important;transition:color .45s cubic-bezier(.7,0,.2,1)}
  #filters button::before{content:"";position:absolute;inset:0;background:var(--ink);transform:scaleX(0);transform-origin:var(--o,left);transition:transform .45s cubic-bezier(.7,0,.2,1);z-index:-1}
  #filters button:hover,#filters button.on{color:var(--bg) !important;border-color:var(--ink) !important;z-index:1}
  #filters button:hover::before,#filters button.on::before{transform:scaleX(1)}
  #filters button:hover span{color:var(--bg);opacity:.6}
</style>
