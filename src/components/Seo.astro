---
import { getSettings } from '../lib/settings.js';

interface Props {
  // The `Seo` field (plugin: seo_metatags) from the current story, if any.
  seo?: Record<string, string> | null;
  // Page-level fallbacks, used when the SEO field is left empty.
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | null;
}

const { seo, title, description, image, type = 'website', jsonLd } = Astro.props;
const settings = await getSettings();

const siteName = settings.SiteName || 'Matan Ben David';

// Three layers, in order: the page's SEO field → the page's own content →
// the site-wide settings story.
const metaTitle = seo?.title || title || siteName;
const metaDescription =
  seo?.description || description || settings.DefaultDescription || '';

const rawImage =
  seo?.og_image || image || settings.DefaultOgImage?.filename || null;
// Storyblok assets get resized to the 1200x630 box social platforms expect.
const ogImage = rawImage?.startsWith('https://a.storyblok.com')
  ? `${rawImage}/m/1200x630/smart`
  : rawImage;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogTitle = seo?.og_title || metaTitle;
const ogDescription = seo?.og_description || metaDescription;
---

<title>{metaTitle}</title>
{metaDescription && <meta name="description" content={metaDescription} />}
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={ogTitle} />
{ogDescription && <meta property="og:description" content={ogDescription} />}
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={seo?.twitter_title || ogTitle} />
{
  (seo?.twitter_description || ogDescription) && (
    <meta
      name="twitter:description"
      content={seo?.twitter_description || ogDescription}
    />
  )
}
{
  (seo?.twitter_image || ogImage) && (
    <meta name="twitter:image" content={seo?.twitter_image || ogImage} />
  )
}

{
  jsonLd && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
