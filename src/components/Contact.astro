---
// the contact form (markup from the prototype; behaviour in src/scripts/contact.js)
---
<div id="contactPop" role="dialog" aria-label="Contact form">
  <div class="cf-body">
    <div class="cf-head"><b>Let’s Collab.</b><button class="cf-x" data-close aria-label="Close"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="1" y="1" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M1 1 23 23M23 1 1 23" stroke="currentColor" stroke-width="1.2"/></svg></button></div>
    <div class="cf-form">
      <div style="display:grid;gap:10px">
        <label data-f="name"><span class="fl">Name</span><input name="name" autocomplete="name" placeholder=" "><small class="err"></small></label>
        <label data-f="email"><span class="fl">Email</span><input name="email" type="email" autocomplete="email" placeholder=" "><small class="err"></small></label>
        <label data-f="msg"><span class="fl">What’s on your mind?</span><textarea name="msg" rows="1" placeholder=" "></textarea></label>
        <div class="cf-b">Budget<div class="cf-budget">
          <button type="button" data-b="Not sure">Not sure</button><button type="button" data-b="&lt;10K">&lt;10K</button><button type="button" data-b="10–25K">10–25K</button><button type="button" data-b="25–50K">25–50K</button><button type="button" data-b="50–100K">50–100K</button><button type="button" data-b="100K+">100K+</button>
        </div></div>
      </div>
    </div>
    <div class="cf-done">Thanks <em class="cf-name"></em>, I’ll be in touch soon.</div>
  </div>
  <button class="cf-stub" type="button" aria-label="Send message — tear off the stub"><span>Send message</span></button>
</div>
