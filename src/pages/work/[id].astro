---
// /work/<project> — for now the case opens over the home page (#project/<id>); this page forwards there.
// TODO: a full static project page (same layout as the overlay) for search engines and sharing.
import { getProjects } from '../../lib/cms';
export async function getStaticPaths(){
  return (await getProjects()).filter(p => p.hasCase).map(p => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const to = `/#project/${p.id}`;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"><title>{p.name} — Streetlight</title>
  <meta name="description" content={p.lines.join(' ') || `${p.name} — ${p.industry}, ${p.year}`}>
  <link rel="canonical" href={new URL(`/work/${p.id}`, Astro.site)}>
  <meta http-equiv="refresh" content={`0; url=${to}`}>
  <script is:inline define:vars={{ to }}>location.replace(to);</script>
</head><body><a href={to}>{p.name}</a></body></html>
