---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/cms';
const projects = await getProjects();
const DISC = ['Product', 'Website', 'Branding', 'Marketing'];
const count = (t: string | null) => t ? projects.filter(p => p.disciplines.includes(t)).length : projects.length;
---
<Base title="All projects" description="Selected brand, web and product work by Streetlight.">
  <section class="page">
    <h1>All projects <em id="count">({projects.length})</em></h1>
    <nav class="chips" id="filters" aria-label="Filter by discipline">
      {[null, ...DISC].map(t => <button data-t={t ?? ''} class={t ? '' : 'on'}>{t ?? 'All'}<span>{count(t)}</span></button>)}
    </nav>
    <div class="m-table work-table" role="table">
      <div class="m-row m-head" role="row"><span>Project</span><span>Industry</span><span>Year</span><span></span></div>
      {projects.map(p => {
        const href = p.hasCase ? `/#project/${p.id}` : (p.live ?? undefined);   // case pages open over the home page (the cube flies in)
        const ext = !p.hasCase && p.live;
        return (
          <a class="m-row" role="row" href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} data-tags={p.disciplines.join(',')}>
            <span>{p.name}<span class="st" role="button" tabindex="0" title="Status (temporary)" data-id={p.id} data-def={p.chapters?.length ? 'review' : 'empty'}></span></span><span class="c2">{p.industry}</span><span class="c3">{p.year}</span>
            {ext ? <span class="go ext" aria-label="opens the live site">↗</span> : <span class="go"><span class="l-arr"><i>→</i><i>→</i></span></span>}
            {(p.hasCase && p.live) && <span class="m-acts">
              <span class="m-btn" data-live={p.live}>View live ↗</span><span class="m-btn solid">View case</span>
            </span>}
            {(!p.hasCase && p.live) && <span class="m-acts"><span class="m-btn">View live ↗</span></span>}
            {(!p.hasCase && !p.live && p.soon) && <span class="soon">Coming soon</span>}
          </a>
        );
      })}
    </div>
    <!-- hover preview: one fixed 16:9 window with each project's cover; moving between rows slides to the next one -->
    <div id="pv" aria-hidden="true"><div class="strip">
      {projects.map((p, i) => p.hero
        ? <div class="it">{p.hero.video && !p.hero.poster ? <video src={p.hero.url} muted loop playsinline autoplay preload="none"></video> : <img src={p.hero.video ? p.hero.poster : /a\.storyblok\.com/.test(p.hero.url) ? `${p.hero.url}/m/800x0` : p.hero.url} alt="" loading="lazy">}</div>
        : <div class="it ph" style={`background:${['#1b1b1b', '#8c8c8c', '#d9d4c3', '#706d63'][i % 4]}`}>{p.name}</div>)}
    </div></div>
  </section>
</Base>

<style>
  .work-table{--cols:var(--c1,280px) var(--c2,160px) var(--c3,90px) 1fr 28px}
  .go.ext{justify-content:flex-end;color:var(--mute)}
  .work-table .soon{grid-column:4 / -1;justify-self:end;align-self:center;color:var(--mute);font-size:12px;letter-spacing:.04em;text-transform:uppercase}
  .work-table .m-row:has(.soon) .go{display:none}
  #pv{position:fixed;right:max(24px,calc((100vw - 1200px) / 2 + 220px));top:50%;width:min(400px,30vw);aspect-ratio:16/9;border:1px solid var(--ink);z-index:30;pointer-events:none;overflow:hidden;
      transform:translateY(-50%) scale(0);transition:transform .4s cubic-bezier(.32,0,.67,0)}
  #pv.on{transform:translateY(-50%) scale(1);transition:transform .4s cubic-bezier(.76,0,.24,1)}
  #pv .strip{position:absolute;inset:0;transition:transform .5s cubic-bezier(.76,0,.24,1)}
  #pv .it{height:100%;display:grid;place-items:center;overflow:hidden}
  #pv .it img,#pv .it video{width:100%;height:100%;object-fit:cover;display:block}
  #pv .it.ph{color:#f3f2ee;font-size:20px;letter-spacing:-.02em;text-align:center;padding:24px}
  @media (max-width:800px), (hover:none){ #pv{display:none} }
  /* TEMPORARY: content status per project (stored in this browser only) */
  .st{display:inline-block;vertical-align:middle;margin-left:10px;padding:1px 7px;border-radius:999px;font-size:10px;letter-spacing:.04em;text-transform:uppercase;line-height:1.5;color:#111;cursor:pointer;user-select:none}
  .st[data-s="empty"]{background:#ff6b5a} .st[data-s="review"]{background:#f6cf45} .st[data-s="done"]{background:#5bc77a}
  /* phones: project + year (+ ↗ when it opens a live site) */
  @media (max-width:800px){ .work-table{--cols:1fr auto 16px} .work-table .m-row > span:nth-child(2){display:none} .work-table .m-row > .go:not(.ext){visibility:hidden} }
</style>

<script>
  const table = document.querySelector('.work-table') as HTMLElement, rows = [...table.querySelectorAll<HTMLElement>('.m-row:not(.m-head)')];
  // "View live" on a row that also has a case: opens the live site instead of the row's case link
  table.addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-live]'); if (!b) return; e.preventDefault(); window.open(b.dataset.live, '_blank', 'noopener'); });
  // TEMPORARY: status tag per project — click cycles empty → review → done; saved in this browser
  const ORDER = ['empty', 'review', 'done'], KEY = 'sl-status';
  let ST: Record<string, string> = {}; try { ST = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch(e){}
  const paint = (el: HTMLElement) => { const s = ST[el.dataset.id!] || el.dataset.def!; el.dataset.s = s; el.textContent = s; };
  const tags = [...table.querySelectorAll<HTMLElement>('.st')]; tags.forEach(paint);
  const cycle = (el: HTMLElement) => { ST[el.dataset.id!] = ORDER[(ORDER.indexOf(el.dataset.s!) + 1) % 3]; try { localStorage.setItem(KEY, JSON.stringify(ST)); } catch(e){} paint(el); };
  table.addEventListener('click', e => { const el = (e.target as HTMLElement).closest<HTMLElement>('.st'); if (!el) return; e.preventDefault(); e.stopPropagation(); cycle(el); }, true);
  table.addEventListener('keydown', e => { const el = (e.target as HTMLElement).closest<HTMLElement>('.st'); if (el && (e.key === 'Enter' || e.key === ' ')){ e.preventDefault(); cycle(el); } });
  // filters: a project shows under every discipline it has; the rest fold away
  const filters = document.getElementById('filters')!, countEl = document.getElementById('count')!;
  function apply(t: string){
    let n = 0;
    rows.forEach(r => { const ok = !t || r.dataset.tags!.split(',').includes(t); r.classList.toggle('out', !ok); if (ok) n++; });
    countEl.textContent = `(${n})`;
    filters.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.t === t));
    try { history.replaceState(null, '', t ? '#' + t.toLowerCase() : location.pathname); } catch(e){}
  }
  filters.addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) apply(b.dataset.t!); });
  const h = location.hash.slice(1); const pre = [...filters.querySelectorAll('button')].find(b => b.dataset.t!.toLowerCase() === h); if (pre) apply(pre.dataset.t!);
  // hover preview: scales in over the list, slides to the hovered project's cover
  const pv = document.getElementById('pv')!, strip = pv.querySelector('.strip') as HTMLElement; let pvOff: number;
  rows.forEach((r, i) => r.addEventListener('mouseenter', () => { clearTimeout(pvOff); strip.style.transform = `translateY(${-100 * i}%)`; pv.classList.add('on'); }));
  table.addEventListener('mouseleave', () => { pvOff = window.setTimeout(() => pv.classList.remove('on'), 60); });
  // columns hug their content
  const fit = () => { [1, 2, 3].forEach(c => { let w = 0;
    table.querySelectorAll(`.m-row > span:nth-child(${c})`).forEach(sp => { const r = document.createRange(); r.selectNodeContents(sp); w = Math.max(w, r.getBoundingClientRect().width); });
    table.style.setProperty('--c' + c, Math.ceil(w + 14) + 'px'); }); };
  fit(); addEventListener('resize', fit); document.fonts?.ready.then(fit);
</script>
