---
import Layout from '../layouts/Layout.astro';
// Form handled by Web3Forms (works on any host, incl. Vercel). Submissions are
// emailed to the address the access key was created with. The key is public
// by design — it only allows sending to that inbox.
const WEB3FORMS_KEY = '760a2983-955f-47d8-bc44-378cc5f42c19';
---

<Layout title="Contact — Matan Ben David">
  <section class="hero">
    <h1 class="hero-title">Let's talk.</h1>
  </section>

  <section class="contact">
    <form class="contact-form" method="POST" action="https://api.web3forms.com/submit">
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New message from the portfolio" />
      <!-- Extra recipients (CC). Separate several addresses with ";". -->
      <input type="hidden" name="ccemail" value="matan@studiostreetlight.com" />
      <input type="hidden" name="redirect" value="/thanks" id="form-redirect" />
      <input class="form-honeypot" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

      <label class="form-field">
        <span class="form-label">Name</span>
        <input class="form-input" type="text" name="name" required />
      </label>

      <label class="form-field">
        <span class="form-label">Email</span>
        <input class="form-input" type="email" name="email" required />
      </label>

      <label class="form-field">
        <span class="form-label">Message</span>
        <textarea class="form-textarea" name="message" rows="6" required></textarea>
      </label>

      <button class="form-button" type="submit">Send</button>
    </form>
  </section>
</Layout>

<script>
  // Web3Forms needs an absolute redirect URL; build it from the current domain.
  const r = document.getElementById('form-redirect') as HTMLInputElement | null;
  if (r) r.value = `${location.origin}/thanks`;
</script>
