---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/cms';
import { blocksToHtml } from '../../lib/post';
export async function getStaticPaths(){
  const posts = await getPosts();
  return posts.map(p => ({ params: { id: p.id }, props: { post: p, all: posts } }));
}
const { post, all } = Astro.props;
const html = blocksToHtml(post.blocks);
const first = post.blocks.find((b: any) => b.p) as any;
const description = first ? first.p.replace(/\*\*/g, '').slice(0, 155) : post.title;
const others = all.filter(p => p.id !== post.id);
---
<Base title={post.title} description={description} lang="he">
  <section class="post" dir="rtl" lang="he">
    <div class="a-head">
      <div class="idx">{post.topic}</div>
      <h1>{post.title}</h1>
      <div class="a-date">{post.date}</div>
    </div>
    <article set:html={html} />
    <section class="more" id="more">
      <h2>פוסטים נוספים</h2>
      <ul data-others={JSON.stringify(others.map(o => ({ id: o.id, title: o.title, date: o.date })))}>
        {others.slice(0, 3).map(o => <li><a href={`/thoughts/${o.id}`}><span>{o.title}</span><i>{o.date}</i></a></li>)}
      </ul>
    </section>
  </section>
</Base>

<style>
  .post{--col:800px;padding:150px max(var(--gut), calc((100vw - var(--col)) / 2)) 80px;max-width:none}
  .a-head{border-bottom:1px solid var(--ink);padding-bottom:28px;max-width:var(--col)}
  .a-date{color:var(--mute);margin-top:16px}
  h1{font-size:60px;font-weight:400;letter-spacing:-.03em;line-height:1.05}
  article{max-width:var(--col);margin-top:56px;font-size:16px;line-height:1.75}
  article :global(h2){font-size:24px;font-weight:400;letter-spacing:-.02em;line-height:1.2;margin:56px 0 16px}
  article :global(p){margin-bottom:20px}
  article :global(mark){background:var(--acc);color:#fff;padding:.08em .25em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  article :global(ol),article :global(ul){margin:0 0 24px;list-style:none;border-top:1px solid var(--soft)}
  article :global(li){padding:14px 0;border-bottom:1px solid var(--soft);display:grid;grid-template-columns:40px 1fr}
  article :global(ul.links li){display:block}
  article :global(li i){font-style:normal;color:var(--mute)}
  article :global(a){color:var(--ink);text-decoration:underline;text-decoration-color:var(--acc);text-underline-offset:4px;transition:color .2s}
  article :global(a:hover){color:var(--acc)}
  .more{max-width:var(--col);margin-top:96px}
  .more h2{font-size:24px;font-weight:400;letter-spacing:-.02em;margin-bottom:16px}
  .more :global(ul){list-style:none;border-top:1px solid var(--ink)}
  .more :global(li){position:relative;border-bottom:1px solid var(--ink);isolation:isolate;overflow:hidden}
  .more :global(li::before){content:"";position:absolute;inset:0;background:var(--acc);transform:scaleY(0);transform-origin:var(--o,top);transition:transform .45s var(--ease);z-index:-1}
  .more :global(li.h::before){transform:scaleY(1)}
  .more :global(a){display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 0;color:var(--ink);text-decoration:none}
  .more :global(a span){transition:transform .45s var(--ease),color .4s}
  .more :global(a i){font-style:normal;color:var(--mute);transition:color .4s;white-space:nowrap}
  .more :global(li.h a span){transform:translateX(-12px);color:var(--bg)} .more :global(li.h a i){color:var(--bg)}
  @media (max-width:800px){
    .post{padding:110px var(--gut) 60px}
    h1{font-size:clamp(34px,10vw,48px)}
    article{margin-top:40px}
    .more{margin-top:72px}
  }
</style>

<script>
  import { rowHover } from '../../scripts/site.js';
  // three other posts, picked at random on each visit
  const ul = document.querySelector('.more ul') as HTMLElement;
  const others = JSON.parse(ul.dataset.others!).sort(() => Math.random() - .5).slice(0, 3);
  ul.innerHTML = others.map((o: any) => `<li><a href="/thoughts/${o.id}"><span></span><i></i></a></li>`).join('');
  ul.querySelectorAll('li').forEach((li, k) => { li.querySelector('span')!.textContent = others[k].title; li.querySelector('i')!.textContent = others[k].date; li.querySelector('a')!.href = '/thoughts/' + others[k].id; rowHover(li); });
</script>
