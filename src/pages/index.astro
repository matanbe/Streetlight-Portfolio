---
import Layout from '../layouts/Layout.astro';
import { storyblokApi } from '@storyblok/astro/client';

// Projects come from the `projects` folder in Storyblok (content type `Project`).
// Draft content in dev and on the preview deployment; published in production.
const isDraft = import.meta.env.DEV || import.meta.env.STORYBLOK_IS_PREVIEW === 'yes';
const { data } = await storyblokApi.get('cdn/stories', {
  version: isDraft ? 'draft' : 'published',
  starts_with: 'projects/',
  content_type: 'Project',
  sort_by: 'position:asc',
  per_page: 100,
});

const projects = data.stories.map((story) => ({
  title: story.content.Title || story.name,
  description: story.content.Description,
  // Resize through Storyblok's image service to match the 4:3 card box.
  thumb: story.content.Thumb?.filename
    ? `${story.content.Thumb.filename}/m/600x450/smart`
    : null,
  thumbAlt: story.content.Thumb?.alt || '',
  href: `/${story.full_slug}`,
}));

// The home page's own story (content type Page) holds the SEO field, if it
// exists; the site falls back to the settings story when it doesn't.
let seo = null;
try {
  const home = await storyblokApi.get('cdn/stories/home', {
    version: isDraft ? 'draft' : 'published',
  });
  seo = home.data.story.content.Seo ?? null;
} catch {
  seo = null;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matan Ben David',
  jobTitle: 'Independent designer',
  url: Astro.site?.href,
};
---

<Layout seo={seo} jsonLd={jsonLd}>
  <section class="hero">
    <h1 class="hero-title">Independent designer working across brand, web and product.</h1>
  </section>

  <section class="projects" id="work">
    <h2 class="section-title">Selected work</h2>
    <div class="project-grid">
      {
        projects.map((p) => (
          <a class="project-card" href={p.href}>
            <div class="project-image">
              {p.thumb && <img src={p.thumb} alt={p.thumbAlt} width="600" height="450" loading="lazy" />}
            </div>
            <h3 class="project-title">{p.title}</h3>
            <p class="project-meta">{p.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
