---
import Layout from '../../layouts/Layout.astro';
import { storyblokApi } from '@storyblok/astro/client';
import { getPayload, storyblokEditable } from '@storyblok/astro';
import StoryblokRichText from '@storyblok/astro/StoryblokRichText.astro';

// Production (static): one page per `Project` story, generated at build time.
// Ignored on the preview deployment, which renders pages on request instead.
export async function getStaticPaths() {
  const { data } = await storyblokApi.get('cdn/stories', {
    version: import.meta.env.DEV ? 'draft' : 'published',
    starts_with: 'projects/',
    content_type: 'Project',
    per_page: 100,
  });

  return data.stories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const isPreview = import.meta.env.STORYBLOK_IS_PREVIEW === 'yes';

let story = Astro.props.story;
if (isPreview) {
  // Inside the Visual Editor, unsaved edits arrive with the request (live
  // preview); otherwise fetch the latest draft.
  const payload = await getPayload({ locals: Astro.locals });
  story = payload.story;
  if (!story) {
    const { data } = await storyblokApi.get(`cdn/stories/projects/${Astro.params.slug}`, {
      version: 'draft',
    });
    story = data.story;
  }
}

const c = story.content;

const title = c.Title || story.name;
const description = c.Description;
const thumb = c.Thumb?.filename ? `${c.Thumb.filename}/m/1600x0` : null;
const thumbAlt = c.Thumb?.alt || '';

// Only show the facts that are filled in.
const facts = [
  ['Client', c.Client],
  ['Role', c.Role],
  ['Year', c.Year],
].filter(([, value]) => value);

// Rich text counts as empty when it has no text or images in it.
const hasBody = Boolean(
  c.Body?.content?.some((node) => node.content?.length || node.type === 'image'),
);

const gallery = (c.Gallery ?? []).filter((img) => img?.filename);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  creator: { '@type': 'Person', name: 'Matan Ben David' },
  ...(c.Thumb?.filename ? { image: c.Thumb.filename } : {}),
  ...(c.Year ? { dateCreated: String(c.Year) } : {}),
};
---

<Layout
  title={`${title} — Matan Ben David`}
  description={description}
  seo={c.Seo ?? c.seo}
  image={c.Thumb?.filename}
  type="article"
  jsonLd={jsonLd}
>
  <article {...storyblokEditable(c)}>
    <section class="hero">
      <h1 class="hero-title">{title}</h1>
      {description && <p class="page-text">{description}</p>}
    </section>

    {
      facts.length > 0 && (
        <section class="project-facts">
          {facts.map(([label, value]) => (
            <div class="project-fact">
              <p class="project-fact-label">{label}</p>
              <p class="project-fact-value">{value}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      thumb && (
        <section class="project-cover">
          <img class="project-cover-image" src={thumb} alt={thumbAlt} />
        </section>
      )
    }

    {
      hasBody && (
        <section class="project-body">
          <StoryblokRichText document={c.Body} />
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section class="project-gallery">
          {gallery.map((img) => (
            <img
              class="project-gallery-image"
              src={`${img.filename}/m/1600x0`}
              alt={img.alt || ''}
              loading="lazy"
            />
          ))}
        </section>
      )
    }
  </article>
</Layout>
